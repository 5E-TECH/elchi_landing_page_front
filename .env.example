# Bu faylning nusxasini `.env.local` deb saqlang va qiymatlarni to'ldiring.
# `.env.local` hech qachon commit qilinmaydi (.gitignore da).

# Saytning yakuniy manzili — sitemap, hreflang va OG havolalari shundan quriladi.
NEXT_PUBLIC_SITE_URL=https://elchipochta.uz

# "Ariza qoldirish" formasi Telegramga yuboriladi.
# 1) @BotFather da bot yarating -> token oling
# 2) Botni menejerlar guruhiga qo'shing
# 3) Guruh chat_id sini oling (masalan @getidsbot orqali; guruh id manfiy bo'ladi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=
